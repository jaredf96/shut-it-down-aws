# Copy to .env (loaded by your shell/uvicorn) to configure the backend.
# Everything here is OPTIONAL — with none of it set, the app runs fully
# in-memory and scan history is simply disabled.

# Region used for scanning and for DynamoDB.
AWS_REGION=us-east-1

# --- Scan-history persistence (DynamoDB) ---------------------------------
# Set a table name to ENABLE persistence. Leave unset to disable it.
# DYNAMODB_TABLE_NAME=cloud-lab-scans

# Point at a local DynamoDB (e.g. dynamodb-local) instead of real AWS:
# DYNAMODB_ENDPOINT_URL=http://localhost:8001

# Auto-create the table on startup (handy for local dev; leave off in prod
# where the table is managed by Terraform/CDK):
# DYNAMODB_AUTO_CREATE=true

# --- Tenancy / auth ------------------------------------------------------
# Require an API key on every data request. Off by default so local use needs
# no credentials and runs as the default tenant.
# AUTH_REQUIRED=true

# Tenant used when no API key is presented (local / single-tenant mode):
# DEFAULT_TENANT_ID=default

# --- Guided cleanup (MUTATING — off by default) --------------------------
# Master safety switch. Without this, all cleanup endpoints refuse to act.
# Only enable when you understand that cleanup will modify real AWS resources.
# ENABLE_CLEANUP_ACTIONS=true

# --- Cost estimates ------------------------------------------------------
# Refine estimates with the live AWS Pricing API (needs pricing:GetProducts).
# Off by default — estimates come from a built-in static price map.
# ENABLE_LIVE_PRICING=true

# --- Notifications (email + Slack) ---------------------------------------
# Configure any subset. With none set, notification calls are safe no-ops.

# Slack Incoming Webhook URL:
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Email (SMTP). Email is only sent when both SMTP_HOST and ALERT_EMAIL_TO are set.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=secret
# SMTP_USE_TLS=true
# ALERT_EMAIL_FROM=alerts@yourdomain.com
# ALERT_EMAIL_TO=you@example.com,teammate@example.com

# Deliver alerts automatically on every GET /scan:
# NOTIFY_ON_SCAN=true
# Only alerts at/above this severity are delivered (INFO | WARNING | CRITICAL):
# NOTIFY_MIN_SEVERITY=WARNING
