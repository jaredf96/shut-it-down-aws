# Python
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / frontend
frontend/node_modules/
frontend/dist/

# Environment & credentials — never commit AWS keys or secrets
.env
.env.*
!.env.example
# The demo build profile is config, not a secret — it must be committed or the
# public demo build cannot be reproduced in CI.
!.env.demo
.aws/

# Terraform — state can contain secrets/ARNs
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Saved plans embed the full resource graph, including resolved values.
*.tfplan
# NOTE: .terraform.lock.hcl is deliberately NOT ignored — the provider lock
# belongs in version control so applies are reproducible.

# Editor / OS
.DS_Store
.idea/
.vscode/
