# Python
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / frontend
frontend/node_modules/
frontend/dist/

# Environment & credentials — never commit AWS keys or secrets
.env
.env.*
!.env.example
# The demo build profile is config, not a secret — it must be committed or the
# public demo build cannot be reproduced in CI.
!.env.demo
.aws/

# Terraform — state can contain secrets/ARNs
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Saved plans embed the full resource graph, including resolved values.
*.tfplan
# NOTE: .terraform.lock.hcl is deliberately NOT ignored — the provider lock
# belongs in version control so applies are reproducible.

# Editor / OS
.DS_Store
.idea/
.vscode/

# Working handoff notes. They describe defects that are not fixed yet, which is
# not something to publish, they go stale the moment the work lands, and they
# carry live values — external IDs, account ids — that belong nowhere near a
# remote. Keep them local; force-add only if you have decided a specific one
# belongs in git.
#
# Unanchored on purpose. This said `docs/HANDOFF*.md` and so matched nothing
# when the baton was written to the repo root, which is where every one of them
# has actually landed.
HANDOFF*.md
