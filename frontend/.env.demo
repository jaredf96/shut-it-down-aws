# Build profile for the PUBLIC demo (vite build --mode demo).
#
# Selects the fixture-backed provider. Rollup then tree-shakes the API client
# out of the bundle entirely, so the published demo contains no API endpoints
# and no credential handling — verified by inspecting the built asset.
#
# Deliberately absent: VITE_API_BASE_URL and VITE_API_KEY. Vite inlines every
# VITE_* variable into public JavaScript, so a key here would be published.
VITE_DEMO_MODE=true
