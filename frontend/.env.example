# Copy to .env to override the backend URL (defaults to http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Optional: API key for a shared deployment (backend with AUTH_REQUIRED=true).
# Leave unset for local dev — the backend runs as the default workspace.
#
# Vite inlines this into the JavaScript it emits, so setting it publishes the key
# to everyone who can fetch the bundle. Set it only for a build whose files stay
# private; never for one served from a public origin. See .env.demo.
# VITE_API_KEY=clc_your-key-here
